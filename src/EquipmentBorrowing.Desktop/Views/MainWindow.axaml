<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EquipmentBorrowing.Desktop.ViewModels"
        x:Class="EquipmentBorrowing.Desktop.Views.MainWindow"
        Title="Campus Equipment Borrowing System" Width="900" Height="600">
	<Grid ColumnDefinitions="200, *">
		<!-- Sidebar Navigation -->
		<StackPanel Grid.Column="0" Background="#F0F0F0" Margin="10">
			<TextBlock Text="Menu" FontWeight="Bold" Margin="0,0,0,10"/>
			<Button Content="Equipment" Command="{Binding NavigateToEquipmentCommand}" Margin="0,5"/>
			<Button Content="Active Borrowings" Command="{Binding NavigateToBorrowingsCommand}" Margin="0,5"/>
		</StackPanel>
		<!-- Content Area -->
		<TransitioningContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="10"/>
	</Grid>
</Window>