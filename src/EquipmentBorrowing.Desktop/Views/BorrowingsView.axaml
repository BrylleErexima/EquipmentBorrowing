<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             x:Class="EquipmentBorrowing.Desktop.Views.BorrowingsView"
             x:DataType="vm:BorrowingsViewModel">
	<DockPanel>
		<TextBlock DockPanel.Dock="Top" Text="Active Borrowings" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>

		<StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
			<Button Content="Return Equipment" Command="{Binding ReturnCommand}"/>
			<TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"/>
		</StackPanel>

		<ListBox ItemsSource="{Binding ActiveBorrowings}" SelectedItem="{Binding SelectedBorrowing}">
			<ListBox.ItemTemplate>
				<DataTemplate DataType="vm:BorrowingDisplayItem">
					<StackPanel Margin="4">
						<TextBlock Text="{Binding EquipmentName}" FontWeight="Bold"/>
						<TextBlock Text="{Binding StudentName}"/>
						<TextBlock Text="{Binding ExpectedReturnDate, StringFormat='Due: {0:d}'}" Opacity="0.6"/>
					</StackPanel>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
	</DockPanel>
</UserControl>