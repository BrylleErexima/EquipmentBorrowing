<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EquipmentBorrowing.Desktop.ViewModels;assembly=EquipmentBorrowing.Desktop"
             xmlns:domain="clr-namespace:EquipmentBorrowing.Domain;assembly=EquipmentBorrowing.Domain"
             x:Class="EquipmentBorrowing.Desktop.Views.BorrowingsView"
             x:DataType="vm:BorrowingsViewModel">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" Text="Active Borrowings" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
        
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button Content="Return Selected Equipment" Command="{Binding ReturnCommand}" HorizontalAlignment="Left"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="Red" Margin="0,5,0,0"/>
        </StackPanel>

        <ListBox ItemsSource="{Binding ActiveBorrowings}" SelectedItem="{Binding SelectedBorrowing}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="domain:Borrowing">
                    <StackPanel Orientation="Horizontal" Spacing="15" Margin="5">
                        <TextBlock Text="{Binding Id, StringFormat='Borrowing #{0}'}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding EquipmentId, StringFormat='Equipment ID: {0}'}"/>
                        <TextBlock Text="{Binding StudentId, StringFormat='Student ID: {0}'}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>